<view class="page">

  <!-- 顶部 -->
  <view class="hero">
    <view class="h1">标题生成器</view>
    <view class="sub">输入产品，直接出能用的抖音 / 小红书标题</view>
  </view>

  <!-- 输入 -->
  <view class="field">
    <view class="field-top">
      <text class="field-label">产品 / 主题</text>
      <text class="field-count">{{topicLen}}/30</text>
    </view>
    <input
      class="input"
      value="{{topic}}"
      placeholder="比如：保温杯、无线耳机、宠物湿粮"
      placeholder-class="ph"
      maxlength="30"
      confirm-type="done"
      bindinput="onTopicInput"
      bindconfirm="onGenerate"
    />
  </view>

  <!-- 平台 -->
  <view class="section">
    <view class="section-label">发布平台</view>
    <view class="seg">
      <view
        wx:for="{{platforms}}"
        wx:key="id"
        class="seg-item {{platform === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPlatform"
      >{{item.name}}</view>
    </view>
    <view class="hint">{{platformHint}}</view>
  </view>

  <!-- 风格 -->
  <view class="section">
    <view class="section-label">标题风格</view>
    <view class="chips">
      <view
        wx:for="{{styles}}"
        wx:key="id"
        class="chip {{style === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onStyle"
      >{{item.name}}</view>
    </view>
    <view class="hint">{{styleHint}}</view>
  </view>

  <!-- 主按钮 -->
  <view class="btn-primary {{generating ? 'dim' : ''}}" bindtap="onGenerate">
    {{generating ? '生成中…' : (list.length ? '换一批' : '生成 3 条标题')}}
  </view>

  <!-- 结果 -->
  <block wx:if="{{list.length}}">
    <view class="result-head">
      <text class="result-title">生成结果</text>
      <text class="result-count">{{list.length}} 条</text>
    </view>

    <view class="list">
      <view class="item" wx:for="{{list}}" wx:key="id">
        <view class="item-top">
          <text class="idx">{{index + 1}}</text>
          <text class="item-text">{{item.text}}</text>
        </view>
        <view class="item-bottom">
          <view class="meta">
            <text class="tag">{{item.styleName}}</text>
            <text class="tag warn" wx:if="{{item.wide}}">偏长</text>
            <text class="len">{{item.length}} 字</text>
          </view>
          <view class="copy" data-index="{{index}}" bindtap="onCopy">复制</view>
        </view>
      </view>
    </view>

    <!-- 解锁批量 -->
    <view class="unlock" wx:if="{{!unlocked}}" bindtap="onUnlock">
      <view class="unlock-main">解锁批量生成</view>
      <view class="unlock-sub">看一段激励视频，一次出 15 条</view>
    </view>
    <view class="unlocked-tip" wx:else>已解锁，一次最多 15 条</view>
  </block>

  <!-- 空态 -->
  <view class="empty" wx:else>
    <view class="empty-line"></view>
    <view class="empty-text">填一个词，按下生成</view>
  </view>

  <!-- banner 广告位：未配置 unit-id 时不渲染，避免报错 -->
  <ad wx:if="{{adUnitId}}" unit-id="{{adUnitId}}" ad-type="banner" ad-theme="white"></ad>

  <view class="footer">本地生成，不上传任何输入内容</view>
</view>
