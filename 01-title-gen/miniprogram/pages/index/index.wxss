.page {
  padding: 24rpx 32rpx 60rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding-top: 16rpx;
}

.h1 {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86868E;
  line-height: 1.5;
}

/* ---------- 输入 ---------- */
.field {
  margin-top: 40rpx;
  background: #F6F6F8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 26rpx;
}

.field-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-label {
  font-size: 24rpx;
  color: #86868E;
}

.field-count {
  font-size: 22rpx;
  color: #B4B4BC;
}

.input {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #101014;
  height: 48rpx;
  line-height: 48rpx;
}

.ph {
  color: #B4B4BC;
  font-weight: 400;
  font-size: 30rpx;
}

/* ---------- 区块 ---------- */
.section {
  margin-top: 40rpx;
}

.section-label {
  font-size: 24rpx;
  color: #86868E;
  margin-bottom: 16rpx;
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #B4B4BC;
}

/* 分段控件 */
.seg {
  display: flex;
  background: #F1F1F4;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #6C6C76;
  padding: 16rpx 0;
  border-radius: 999rpx;
}

.seg-item.on {
  background: #FFFFFF;
  color: #101014;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 风格 chip */
.chips {
  display: flex;
}

.chip {
  margin-right: 16rpx;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E6E6EA;
  font-size: 27rpx;
  color: #3A3A42;
}

.chip.on {
  background: #101014;
  border-color: #101014;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 主按钮 ---------- */
.btn-primary {
  margin-top: 48rpx;
  height: 100rpx;
  border-radius: 22rpx;
  background: #FF4D3D;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.btn-primary.dim {
  opacity: 0.55;
}

/* ---------- 结果 ---------- */
.result-head {
  margin-top: 56rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result-title {
  font-size: 26rpx;
  color: #86868E;
}

.result-count {
  font-size: 24rpx;
  color: #B4B4BC;
}

.list {
  margin-top: 8rpx;
}

.item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F1F1F4;
}

.item-top {
  display: flex;
}

.idx {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C6C6CE;
  font-weight: 600;
  line-height: 1.75;
  font-variant-numeric: tabular-nums;
}

.item-text {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.62;
  color: #101014;
  font-weight: 500;
}

.item-bottom {
  margin-top: 18rpx;
  padding-left: 44rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 20rpx;
  color: #86868E;
  background: #F4F4F6;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.tag.warn {
  color: #B26A00;
  background: #FFF4E0;
}

.len {
  font-size: 20rpx;
  color: #C6C6CE;
}

.copy {
  font-size: 24rpx;
  color: #FF4D3D;
  padding: 6rpx 4rpx 6rpx 24rpx;
}

/* ---------- 解锁 ---------- */
.unlock {
  margin-top: 36rpx;
  background: #FFF3F1;
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
}

.unlock-main {
  font-size: 29rpx;
  font-weight: 600;
  color: #D93A2B;
}

.unlock-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #C4746A;
}

.unlocked-tip {
  margin-top: 36rpx;
  font-size: 23rpx;
  color: #B4B4BC;
  text-align: center;
}

/* ---------- 空态 ---------- */
.empty {
  margin-top: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-line {
  width: 56rpx;
  height: 2rpx;
  background: #E6E6EA;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #C6C6CE;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 21rpx;
  color: #C6C6CE;
}
