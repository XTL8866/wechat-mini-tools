<view class="page">

  <!-- 顶部 -->
  <view class="hero">
    <view class="h1">单位换算</view>
    <view class="sub">输一个数，选好两个单位，结果和换算依据一起给</view>
  </view>

  <!-- 输入 -->
  <view class="field">
    <view class="field-top">
      <text class="field-label">数值</text>
      <text class="field-count">{{count ? count + ' 个' : '一行一个'}}</text>
    </view>
    <input
      class="input"
      value="{{valueText}}"
      placeholder="比如：12"
      placeholder-class="ph"
      maxlength="200"
      confirm-type="done"
      bindinput="onValueInput"
      bindconfirm="onGenerate"
    />
    <view class="field-hint {{valueWarn ? 'warn' : ''}}">{{valueHint}}</view>
  </view>

  <!-- 类别 -->
  <view class="section">
    <view class="section-label">换算类别</view>
    <view class="chips">
      <view
        wx:for="{{cats}}"
        wx:key="key"
        class="chip {{cat === item.key ? 'on' : ''}}"
        data-k="{{item.key}}"
        bindtap="onCat"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 源单位 -->
  <view class="section">
    <view class="section-label">从</view>
    <view class="chips">
      <view
        wx:for="{{fromChips}}"
        wx:key="*this"
        class="chip {{from === item ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onFrom"
      >{{item}}</view>
    </view>
  </view>

  <!-- 目标单位 -->
  <view class="section">
    <view class="section-label">到</view>
    <view class="chips">
      <view
        wx:for="{{toChips}}"
        wx:key="*this"
        class="chip {{to === item ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onTo"
      >{{item}}</view>
    </view>
    <view class="hint">同一类别里随便挑，换单位不用重新输数值</view>
  </view>

  <!-- 主按钮 -->
  <view class="btn-primary {{generating ? 'dim' : ''}}" bindtap="onGenerate">
    {{generating ? '换算中…' : (detail ? '重新换算' : '换算')}}
  </view>

  <!-- 结果 -->
  <block wx:if="{{detail}}">
    <view class="result-head">
      <text class="result-title">换算结果</text>
      <text class="result-count">{{detail.catName}} · {{detail.from}} → {{detail.to}}</text>
    </view>

    <!-- 主结果 -->
    <view class="card main-card">
      <view class="card-top">
        <text class="card-mark">{{detail.catName}}</text>
        <text class="card-spec">{{detail.fromText}} {{detail.from}}</text>
        <view class="copy" bindtap="onCopy">{{copied ? '已复制' : '复制'}}</view>
      </view>
      <view class="bigval">
        <text class="bignum">{{detail.outText}}</text>
        <text class="bigunit">{{detail.to}}</text>
      </view>
      <view class="kv" wx:for="{{detail.mainRows}}" wx:key="k">
        <text class="kv-k">{{item.k}}</text>
        <text class="kv-v">{{item.v}}</text>
      </view>
    </view>

    <!-- 同类全部单位 -->
    <view class="card">
      <view class="card-top">
        <text class="card-mark alt">全部单位</text>
        <text class="card-spec">{{detail.fromText}} {{detail.from}}</text>
        <text class="card-dim">{{detail.tableRows.length}} 个</text>
      </view>
      <view class="kv {{item.on ? 'kv-on' : ''}}" wx:for="{{detail.tableRows}}" wx:key="k">
        <text class="kv-k">{{item.name}} · {{item.k}}</text>
        <text class="kv-v">{{item.text}}</text>
      </view>
    </view>

    <!-- 依据 -->
    <view class="card basis-card">
      <view class="card-top">
        <text class="card-mark basis">依据</text>
        <text class="card-spec">定义值</text>
      </view>
      <view class="basis-text">{{detail.basis}}</view>
    </view>

    <!-- 批量 -->
    <block wx:if="{{rows.length}}">
      <view class="result-head small">
        <text class="result-title">逐值换算</text>
        <text class="result-count">{{rows.length}} 行</text>
      </view>
      <view class="row-head">
        <text class="rh-v">{{detail.from}}</text>
        <text class="rh-out">{{detail.to}}</text>
      </view>
      <view class="row" wx:for="{{rows}}" wx:key="v">
        <text class="row-v">{{item.v}}</text>
        <text class="row-out">{{item.out}}</text>
      </view>
    </block>

    <view class="unlock" wx:if="{{!unlocked}}" bindtap="onUnlock">
      <view class="unlock-main">解锁批量换算</view>
      <view class="unlock-sub">看一段激励视频，一次换 8 个数值</view>
    </view>
    <view class="unlocked-tip" wx:else>已解锁，一次最多 8 个数值</view>
  </block>

  <!-- 空态 -->
  <view class="empty" wx:else>
    <view class="empty-line"></view>
    <view class="empty-text">填一个数值，选好两个单位，按下换算</view>
  </view>

  <!-- banner 广告位：未配置 unit-id 时不渲染，避免报错 -->
  <ad wx:if="{{adUnitId}}" unit-id="{{adUnitId}}" ad-type="banner" ad-theme="white"></ad>

  <view class="footer">系数按国际单位制与英美制定义值，本地计算，不上传任何输入</view>
</view>
