.page {
  padding: 24rpx 32rpx 60rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding-top: 16rpx;
}

.h1 {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86868E;
  line-height: 1.5;
}

/* ---------- 画布 ---------- */
.stage {
  margin-top: 36rpx;
  position: relative;
  background: #F6F6F8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cv {
  display: block;
  border-radius: 24rpx;
}

.stage-empty {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 60rpx;
  color: #C6C6CE;
  line-height: 1;
  font-weight: 300;
}

.stage-empty-text {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #B4B4BC;
}

.stage-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
}

.link {
  font-size: 23rpx;
  color: #FF4D3D;
}

/* ---------- 文字输入 ---------- */
.field {
  margin-top: 30rpx;
  background: #F6F6F8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 18rpx;
}

.field-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-label {
  font-size: 24rpx;
  color: #86868E;
}

.field-count {
  font-size: 22rpx;
  color: #B4B4BC;
}

.ipt {
  margin-top: 14rpx;
  width: 100%;
  height: 76rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #101014;
}

.ph {
  color: #B4B4BC;
  font-size: 29rpx;
  font-weight: 400;
}

.field-actions {
  margin-top: 6rpx;
  display: flex;
  justify-content: space-between;
}

/* ---------- 区块 ---------- */
.section {
  margin-top: 32rpx;
}

.section-label {
  font-size: 24rpx;
  color: #86868E;
  margin-bottom: 16rpx;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B4B4BC;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E6E6EA;
  font-size: 26rpx;
  color: #3A3A42;
  line-height: 1.2;
}

.chip.on {
  background: #101014;
  border-color: #101014;
  color: #FFFFFF;
}

/* ---------- 色板 ---------- */
.sw-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.sw {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin: 0 18rpx 18rpx 0;
  border: 3rpx solid #E6E6EA;
}

.sw.on {
  border-color: #101014;
  box-shadow: 0 0 0 4rpx #FFFFFF inset;
}

.sw-auto {
  width: auto;
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 3rpx solid #E6E6EA;
}

.sw-auto-t {
  font-size: 23rpx;
  color: #3A3A42;
}

.sw-auto.on {
  background: #101014;
  border-color: #101014;
  box-shadow: none;
}

.sw-auto.on .sw-auto-t {
  color: #FFFFFF;
}

/* ---------- 描边开关 ---------- */
.switch-row {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #F6F6F8;
  border-radius: 20rpx;
}

.switch-label {
  font-size: 27rpx;
  color: #101014;
  font-weight: 600;
}

.switch-sub {
  flex: 1;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #B4B4BC;
}

/* ---------- 主按钮 ---------- */
.btn-primary {
  margin-top: 32rpx;
  height: 100rpx;
  border-radius: 22rpx;
  background: #FF4D3D;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.btn-primary.dim {
  opacity: 0.55;
}

/* ---------- 结果 ---------- */
.result-head {
  margin-top: 46rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result-title {
  font-size: 26rpx;
  color: #86868E;
}

.result-count {
  font-size: 23rpx;
  color: #B4B4BC;
}

.meta-row {
  margin-top: 16rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #F1F1F4;
  display: flex;
  align-items: center;
}

.tag {
  font-size: 20rpx;
  color: #86868E;
  background: #F4F4F6;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.len {
  font-size: 20rpx;
  color: #C6C6CE;
}

.btn-save {
  margin-top: 26rpx;
  height: 96rpx;
  border-radius: 22rpx;
  border: 2rpx solid #101014;
  color: #101014;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 解锁 ---------- */
.unlock {
  margin-top: 30rpx;
  background: #FFF3F1;
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
}

.unlock-main {
  font-size: 29rpx;
  font-weight: 600;
  color: #D93A2B;
}

.unlock-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #C4746A;
}

.unlocked-tip {
  margin-top: 30rpx;
  font-size: 23rpx;
  color: #B4B4BC;
  text-align: center;
}

/* ---------- 空态 ---------- */
.empty {
  margin-top: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-line {
  width: 56rpx;
  height: 2rpx;
  background: #E6E6EA;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #C6C6CE;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 21rpx;
  color: #C6C6CE;
}

/* ---------- v2 新增：小 chip、对比度条 ---------- */
.chip.sm {
  padding: 12rpx 26rpx;
  font-size: 24rpx;
}

.link.gray { color: #B4B4BC; }

.hint { line-height: 1.5; }

.meter-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.meter-label {
  font-size: 22rpx;
  color: #86868E;
  width: 130rpx;
  flex-shrink: 0;
}

.meter-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 99rpx;
  background: #EDEDF0;
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  background: #1FA98B;
  border-radius: 99rpx;
}

.meter-fill.low { background: #E8342A; }

.meter-val {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #3A3A42;
  font-weight: 600;
  width: 140rpx;
  text-align: right;
}

.btn-save.done {
  border-color: #C6C6CE;
  color: #B4B4BC;
}
