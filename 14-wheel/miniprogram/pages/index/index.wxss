.page {
  padding: 24rpx 33rpx 60rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding-top: 16rpx;
}

.h1 {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #86868E;
  line-height: 1.5;
}

/* ---------- 预设 ---------- */
.presets {
  margin-top: 30rpx;
  display: flex;
}

.pchip {
  flex: 1;
  margin-right: 12rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: #F4F4F6;
  font-size: 24rpx;
  color: #5A5A64;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pchip:last-child {
  margin-right: 0;
}

/* ---------- 选项 ---------- */
.form {
  margin-top: 16rpx;
  background: #F6F6F8;
  border-radius: 26rpx;
  padding: 4rpx 28rpx 0;
}

.formhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66rpx;
}

.fh-t {
  font-size: 23rpx;
  color: #B4B4BC;
}

.fh-btn {
  font-size: 23rpx;
  color: #FF4D3D;
  padding-left: 26rpx;
}

.farea {
  width: 100%;
  height: 240rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #101014;
  padding: 4rpx 0 8rpx;
}

.fph {
  color: #C6C6CE;
  font-size: 25rpx;
  line-height: 1.72;
}

.ffoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74rpx;
  border-top: 2rpx solid #EDEDF0;
}

.fstat {
  font-size: 22rpx;
  color: #B4B4BC;
}

.toggle {
  display: flex;
  align-items: center;
}

.tg-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid #C6C6CE;
  background: #FFFFFF;
  margin-right: 10rpx;
}

.toggle.on .tg-dot {
  border-color: #FF4D3D;
  background: #FF4D3D;
}

.tg-t {
  font-size: 22rpx;
  color: #86868E;
}

.toggle.on .tg-t {
  color: #FF4D3D;
  font-weight: 600;
}

/* ---------- 主按钮 ---------- */
.gen {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #101014;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 转盘 ---------- */
.stage {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.wheel-wrap {
  position: relative;
  width: 620rpx;
  height: 620rpx;
}

.wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: #EDEDF0;
}

.wheel.spinning {
  transition: transform 2.4s cubic-bezier(0.16, 0.72, 0.15, 1);
}

/* 标签挂在「圆心到 12 点」的竖条上，整条转 mid 度就落到对应扇区 */
.lab {
  position: absolute;
  left: 50%;
  top: 0;
  width: 0;
  height: 310rpx;
  transform-origin: 0 100%;
}

.lab-tx {
  position: absolute;
  top: 26rpx;
  left: -150rpx;
  width: 300rpx;
  text-align: center;
  white-space: nowrap;
  font-weight: 600;
  line-height: 1;
}

.pointer {
  position: absolute;
  left: 50%;
  top: -8rpx;
  margin-left: -16rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 30rpx solid #101014;
  z-index: 6;
}

.hub {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 104rpx;
  height: 104rpx;
  margin: -52rpx 0 0 -52rpx;
  border-radius: 50%;
  background: #101014;
  border: 6rpx solid #FFFFFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.wheel-hint {
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 24rpx;
  color: #B4B4BC;
}

/* ---------- 结果 ---------- */
.res {
  margin-top: 26rpx;
  background: #F6F6F8;
  border-radius: 26rpx;
  padding: 22rpx 26rpx 24rpx;
}

.res-top {
  display: flex;
  align-items: baseline;
}

.res-kind {
  flex: 1;
  font-size: 23rpx;
  color: #86868E;
}

.res-copy {
  font-size: 24rpx;
  color: #FF4D3D;
  padding-left: 20rpx;
}

.res-copy.done {
  color: #B4B4BC;
}

.res-tx {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.28;
  color: #101014;
  overflow-wrap: break-word;
  word-break: normal;
}

.res-empty {
  padding: 22rpx 0 12rpx;
  font-size: 24rpx;
  color: #C6C6CE;
}

.res-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B4B4BC;
}

/* ---------- 记录 ---------- */
.sec-head {
  margin-top: 38rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sec-title {
  font-size: 25rpx;
  color: #86868E;
}

.sec-op {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF4D3D;
}

.sec-sub {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sec-count {
  font-size: 22rpx;
  color: #B4B4BC;
}

.sec-stat {
  font-size: 22rpx;
  color: #86868E;
}

.items {
  margin-top: 4rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F2F2F4;
}

.item-no {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #B4B4BC;
  font-variant-numeric: tabular-nums;
}

.item-tx {
  flex: 1;
  font-size: 26rpx;
  color: #26262C;
}

.item-t {
  font-size: 22rpx;
  color: #C6C6CE;
  font-variant-numeric: tabular-nums;
}

.list-empty {
  margin-top: 16rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #C6C6CE;
  background: #FAFAFB;
  border-radius: 20rpx;
}

.list-hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #C6C6CE;
}

/* ---------- 解锁 ---------- */
.unlock {
  margin-top: 34rpx;
  background: #FFF3F1;
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
}

.unlock-main {
  font-size: 29rpx;
  font-weight: 600;
  color: #D93A2B;
}

.unlock-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #C4746A;
}

.unlocked-tip {
  margin-top: 34rpx;
  font-size: 23rpx;
  color: #B4B4BC;
  text-align: center;
}

/* ---------- 页脚 ---------- */
.note {
  margin-top: 38rpx;
  font-size: 21rpx;
  color: #B4B4BC;
  line-height: 1.85;
}

.footer {
  margin-top: 26rpx;
  text-align: center;
  font-size: 21rpx;
  color: #C6C6CE;
  line-height: 1.6;
}
