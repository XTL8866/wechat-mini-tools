.page {
  padding: 24rpx 32rpx 60rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding-top: 16rpx;
}

.h1 {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86868E;
  line-height: 1.5;
}

/* ---------- 输入 ---------- */
.field {
  margin-top: 40rpx;
  background: #F6F6F8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 26rpx;
}

.field.off {
  background: #FAFAFB;
}

.field-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-label {
  font-size: 24rpx;
  color: #86868E;
}

.field-count {
  font-size: 22rpx;
  color: #B4B4BC;
}

.input {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #101014;
  height: 48rpx;
  line-height: 48rpx;
}

.ph {
  color: #B4B4BC;
  font-weight: 400;
  font-size: 30rpx;
}

/* ---------- 区块 ---------- */
.section {
  margin-top: 40rpx;
}

.section-label {
  font-size: 24rpx;
  color: #86868E;
  margin-bottom: 16rpx;
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #B4B4BC;
  line-height: 1.5;
}

/* 关键词输入 */
.kw-box {
  background: #F6F6F8;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
}

.kw-input {
  font-size: 30rpx;
  font-weight: 500;
  color: #101014;
  height: 44rpx;
  line-height: 44rpx;
}

/* chip：四个一组，允许换行 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E6E6EA;
  font-size: 27rpx;
  color: #3A3A42;
}

.chip.on {
  background: #101014;
  border-color: #101014;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 主按钮 ---------- */
.btn-primary {
  margin-top: 44rpx;
  height: 100rpx;
  border-radius: 22rpx;
  background: #FF4D3D;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.btn-primary.dim {
  opacity: 0.55;
}

/* ---------- 结果 ---------- */
.result-head {
  margin-top: 56rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result-title {
  font-size: 26rpx;
  color: #86868E;
}

.result-count {
  font-size: 24rpx;
  color: #B4B4BC;
}

.list {
  margin-top: 8rpx;
}

.item {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F1F1F4;
}

.item-top {
  display: flex;
}

.idx {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C6C6CE;
  font-weight: 600;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 44rpx;
  font-weight: 700;
  color: #101014;
  letter-spacing: 4rpx;
  line-height: 1.3;
}

.py {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B4B4BC;
  letter-spacing: 1rpx;
}

.mean {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.62;
  color: #5A5A64;
}

.item-bottom {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 20rpx;
  color: #86868E;
  background: #F4F4F6;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.len {
  font-size: 20rpx;
  color: #C6C6CE;
}

.copy {
  font-size: 24rpx;
  color: #FF4D3D;
  padding: 6rpx 4rpx 6rpx 24rpx;
}

/* ---------- 解锁 ---------- */
.unlock {
  margin-top: 36rpx;
  background: #FFF3F1;
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
}

.unlock-main {
  font-size: 29rpx;
  font-weight: 600;
  color: #D93A2B;
}

.unlock-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #C4746A;
}

.unlocked-tip {
  margin-top: 36rpx;
  font-size: 23rpx;
  color: #B4B4BC;
  text-align: center;
}

/* ---------- 空态 ---------- */
.empty {
  margin-top: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-line {
  width: 56rpx;
  height: 2rpx;
  background: #E6E6EA;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #C6C6CE;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 21rpx;
  color: #C6C6CE;
}
